# Backend environment configuration (copy to .env and fill in)

# === Supabase ===
# Tokens are verified against the Supabase Auth server, so the JWT secret is not needed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# === Gemini & Groq ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EVAL_MODEL=gemini-3.5-flash
GEMINI_STT_MODEL=gemini-3.5-flash
GROQ_API_KEY=your-groq-api-key-optional-fallback

# === App ===
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
